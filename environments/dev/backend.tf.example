# Rename this file to backend.tf after running the bootstrap module:
# cp backend.tf.example backend.tf
#
# Replace <STATE_BUCKET_NAME> and <LOCK_TABLE_NAME> with values from bootstrap output:

terraform {
  backend "s3" {
    bucket         = "<STATE_BUCKET_NAME>"
    key            = "environments/dev/terraform.tfstate"
    region         = "ap-south-1"
    dynamodb_table = "<LOCK_TABLE_NAME>"
    encrypt        = true
  }
}
