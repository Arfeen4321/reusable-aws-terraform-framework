# -----------------------------------------------------------------------------
# DYNAMIC AMI LOOKUP FOR SUPPORTED OPERATING SYSTEMS
# -----------------------------------------------------------------------------

# Ubuntu 22.04 LTS (Jammy Jellyfish) - 64-bit x86
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }

  filter {
    name   = "root-device-type"
    values = ["ebs"]
  }
}

# Amazon Linux 2023 - 64-bit x86
data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["137112412989"] # Amazon

  filter {
    name   = "name"
    values = ["al2023-ami-2023.*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }

  filter {
    name   = "root-device-type"
    values = ["ebs"]
  }
}

# Red Hat Enterprise Linux 9 - 64-bit x86
data "aws_ami" "rhel" {
  most_recent = true
  owners      = ["309956199498"] # Red Hat

  filter {
    name   = "name"
    values = ["RHEL-9.*_HVM-*-x86_64-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }

  filter {
    name   = "root-device-type"
    values = ["ebs"]
  }
}

# Debian 12 (Bookworm) - 64-bit x86
data "aws_ami" "debian" {
  most_recent = true
  owners      = ["136693071363"] # Debian

  filter {
    name   = "name"
    values = ["debian-12-amd64-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }

  filter {
    name   = "root-device-type"
    values = ["ebs"]
  }
}

locals {
  # AMI mapping helper
  ami_map = {
    "ubuntu"       = data.aws_ami.ubuntu.id
    "amazon-linux" = data.aws_ami.amazon_linux.id
    "rhel"         = data.aws_ami.rhel.id
    "debian"       = data.aws_ami.debian.id
  }
}
